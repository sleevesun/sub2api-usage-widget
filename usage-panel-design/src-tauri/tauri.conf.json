{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub2API Usage",
  "version": "0.2.0",
  "identifier": "com.sub2api.usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sub2API Usage",
        "width": 420,
        "height": 760,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "orb",
        "title": "Sub2API",
        "width": 280,
        "height": 280,
        "minWidth": 280,
        "minHeight": 280,
        "maxWidth": 280,
        "maxHeight": 280,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.codexradar.com; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "activationPolicy": "accessory",
      "exceptionDomain": "com.sub2api.usage-widget",
      "signingIdentity": null,
      "entitlements": null,
      "infoPlist": {
        "NSUserNotificationAlertStyle": "alert"
      }
    }
  }
}
