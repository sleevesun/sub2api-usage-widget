{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub2API Usage",
  "version": "0.3.0",
  "identifier": "com.sub2api.usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sub2API Usage",
        "width": 420,
        "height": 760,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "orb",
        "title": "Sub2API",
        "width": 280,
        "height": 280,
        "minWidth": 280,
        "minHeight": 280,
        "maxWidth": 280,
        "maxHeight": 280,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "com.sub2api.usage-widget",
      "signingIdentity": null,
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QTU4RTQ5RkJGMkJCODgKUldTSXUvTDdTWTZsU0pKZlVENGhVVzlrakNoV25Dd04zL2dCaVdRc0dnQTgrcXQ4eDhsN2Zld2EK",
      "endpoints": ["https://github.com/sleevesun/sub2api-usage-widget/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
